" value="101"/><column index="2" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">select * from pd_employees;
select * from bank_details;
select * from pd_empersonal;
select * from pd_compensation;


UPDATE bank_details SET branch_name='HYD' WHERE empid='3';

</sql><sql name="SQL 2*">CREATE TABLE IF NOT EXISTS pd_payments (
    pay_id                INTEGER PRIMARY KEY AUTOINCREMENT,
    empid             INTEGER NOT NULL,
    pay_term          TEXT NOT NULL,          -- 'daily', 'weekly', 'bi-weekly', 'monthly'
    amount            REAL NOT NULL,
    monthly_base      REAL NOT NULL,
    paid_at           TEXT NOT NULL,           -- ISO format: '2025-03-09T14:30:00'
    payment_status    TEXT DEFAULT 'completed',
    notes             TEXT,
    created_at        TEXT DEFAULT (datetime('now')),
    
    FOREIGN KEY (empid) REFERENCES employees(empid)
);

-- Optional helpful index
CREATE INDEX IF NOT EXISTS idx_payments_empid ON payments(empid);
CREATE INDEX IF NOT EXISTS idx_payments_paid_at ON payments(paid_at);</sql><current_tab id="1"/></tab_sql></sqlb_project>
